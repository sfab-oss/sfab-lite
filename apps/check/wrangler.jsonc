{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sfab-lite-check",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  // Only the factory calls this worker, and it does so over a service binding,
  // which dispatches worker-to-worker without a public hostname. The
  // workers.dev subdomain was therefore pure surface: `/check` fails closed on
  // a missing ADMIN_TOKEN, but `/health` answered anyone with the URL and
  // enumerated the whole types VFS — every dependency and version the build
  // environment carries. Reach it through the factory's /admin/health instead.
  "workers_dev": false,
  "limits": {
    "cpu_ms": 300000
  }
}
