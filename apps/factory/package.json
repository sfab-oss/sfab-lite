{
  "name": "@sfab-lite/factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "build": "vite build",
    "build:ui": "vite build",
    "dev": "vite dev --port ${FACTORY_PORT:-8790}",
    "dev:ui": "vite dev --port ${FACTORY_PORT:-8790}",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "bake-seed": "node scripts/bake-seed.mjs",
    "upload-kernel-r2": "node scripts/upload-kernel-r2.mjs",
    "bake-template-snapshot": "node --experimental-strip-types scripts/bake-template-snapshot.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.48",
    "@ai-sdk/react": "3.0.204",
    "@better-auth/oauth-provider": "1.6.20",
    "@cloudflare/codemode": "0.4.3",
    "@cloudflare/shell": "0.4.1",
    "@cloudflare/think": "0.13.0",
    "@cloudflare/vite-plugin": "1.46.0",
    "@cloudflare/worker-bundler": "0.2.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@sfab-lite/core": "workspace:*",
    "@sfab-lite/kernel": "workspace:*",
    "@sfab-lite/template": "workspace:*",
    "@sfab-lite/ui": "workspace:*",
    "@tailwindcss/vite": "4.1.11",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "@tanstack/router-plugin": "1.168.19",
    "agents": "0.17.4",
    "ai": "6.0.197",
    "better-auth": "1.6.20",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.31",
    "jose": "6.2.4",
    "just-bash": "3.1.0",
    "lucide-react": "0.475.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.1.11",
    "ulid": "3.0.2",
    "zod": "4.4.3",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260721.1",
    "@sfab-lite/tsconfig": "workspace:*",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "5.1.4",
    "wrangler": "4.113.0"
  }
}
