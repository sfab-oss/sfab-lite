{
  "name": "@sfab-lite/factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json",
    "build": "pnpm build:ui",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev": "wrangler dev -c wrangler.jsonc -c ../check/wrangler.jsonc -c ../lint/wrangler.jsonc --port 8790",
    "dev:ui": "vite --config ui/vite.config.ts",
    "deploy": "wrangler deploy",
    "bake-seed": "node scripts/bake-seed.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.48",
    "@ai-sdk/react": "3.0.204",
    "@base-ui/react": "1.6.0",
    "@cloudflare/codemode": "0.4.3",
    "@cloudflare/shell": "0.4.1",
    "@cloudflare/think": "0.13.0",
    "@cloudflare/worker-bundler": "0.2.2",
    "@sfab-lite/core": "workspace:*",
    "@sfab-lite/kernel": "workspace:*",
    "@sfab-lite/template": "workspace:*",
    "@shadcn/helpers": "0.1.0",
    "@shadcn/react": "0.2.1",
    "agents": "0.17.4",
    "ai": "6.0.197",
    "better-auth": "1.6.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.475.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "3.0.6",
    "streamdown": "2.3.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "1.3.6",
    "ulid": "3.0.2",
    "zod": "4.4.3",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260721.1",
    "@sfab-lite/tsconfig": "workspace:*",
    "@tailwindcss/vite": "4.1.11",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "6.0.3",
    "vite": "7.0.6",
    "wrangler": "4.113.0"
  }
}
