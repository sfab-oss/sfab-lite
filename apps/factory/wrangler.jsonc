{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sfab-lite-factory",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  // A commit awaits check (10-24s measured in production) and lint. The 30s
  // default left almost no margin and correlated with intermittent 1101s.
  "limits": {
    "cpu_ms": 300000
  },
  // The factory's own D1 — auth, organizations, app registry. Exists because
  // Durable Objects cannot be enumerated (`src/env.d.ts`). No app data here.
  //
  // `database_id` is a PLACEHOLDER. Creating the real database is an owner
  // action (`wrangler d1 create sfab-lite-factory`), so it is deliberately not
  // done here — local `wrangler dev` and `--dry-run` do not need a real id, a
  // deploy does. Replace this before the first deploy that includes D1.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sfab-lite-factory",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_DO",
        "class_name": "AppDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AppDO"]
    }
  ],
  "services": [
    {
      "binding": "CHECK",
      "service": "sfab-lite-check"
    },
    {
      "binding": "LINT",
      "service": "sfab-lite-lint"
    }
  ]
}
