{
  "name": "@sfab-lite/check",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "wrangler dev --port 8802",
    "deploy": "wrangler deploy",
    "test:regression": "node scripts/regression-delete-readd-inprocess.mjs",
    "test:store-bound": "node scripts/regression-store-bound-inprocess.mjs",
    "test": "node scripts/proof-side-aware.mjs && node scripts/proof-check-units.mjs",
    "test:side-aware": "node scripts/proof-side-aware.mjs",
    "measure:memory": "node scripts/measure-memory.mjs",
    "measure:program": "node scripts/measure-program.mjs",
    "measure:split": "node scripts/measure-split.mjs",
    "measure:zones": "node scripts/run-measure.mjs measure-zones.ts",
    "measure:entities": "node scripts/run-measure.mjs measure-entities.ts",
    "measure:stub-vfs": "node scripts/run-measure.mjs measure-stub-vfs.ts",
    "measure:thin-seed": "node scripts/run-measure.mjs measure-thin-seed.ts",
    "measure:shallow-rpc": "node scripts/run-measure.mjs measure-shallow-rpc.ts",
    "measure:tsgo": "node scripts/run-measure.mjs measure-tsgo.ts",
    "measure:serve-diet": "node scripts/measure-serve-diet.mjs",
    "measure:typed-stubs": "node scripts/run-measure.mjs measure-typed-stubs.ts",
    "measure:stack": "node scripts/run-measure.mjs measure-stack.ts",
    "measure:snapshot": "node scripts/run-measure.mjs measure-snapshot.ts",
    "measure:units": "node scripts/run-measure.mjs measure-units.ts",
    "measure:assembled-recipes": "node scripts/run-measure.mjs measure-assembled-recipes.ts"
  },
  "dependencies": {
    "@sfab-lite/core": "workspace:*",
    "@sfab-lite/kernel": "workspace:*",
    "@sfab-lite/starter-erp": "workspace:*",
    "@sfab-lite/verbs": "workspace:*",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260721.1",
    "wrangler": "4.113.0"
  }
}
