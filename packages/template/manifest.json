{
  "root": "app",
  "server": {
    "entry": "src/hono/index.ts",
    "exportName": "app"
  },
  "client": {
    "entry": "src/ui/main.tsx",
    "styles": "src/ui/styles.css"
  },
  "safelist": "safelist.txt",
  "migrations": "migrations",
  "schema": "src/db/schema/index.ts",
  "inject": {
    "biome.json": "../core/app-biome.json"
  },
  "source": {
    "dirs": ["src", "migrations"],
    "extensions": [".ts", ".tsx", ".css", ".sql", ".json"],
    "files": [
      "safelist.txt",
      "package.json",
      "tsconfig.json",
      "components.json",
      "vite.config.ts"
    ],
    "exclude": ["src/worker.ts"]
  }
}
