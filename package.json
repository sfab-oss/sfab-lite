{
  "name": "sfab-lite",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write .",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:kernel": "node scripts/check-kernel.mjs",
    "check:seed": "node scripts/check-seed.mjs",
    "check:check-memory": "node apps/check/scripts/regression-store-bound-inprocess.mjs",
    "check:export-agreement": "node scripts/check-export-agreement.mjs",
    "upload-kernel-r2": "pnpm --filter @sfab-lite/factory upload-kernel-r2",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:cycles": "node scripts/check-cycles.mjs",
    "check:dead-code": "knip",
    "prepare": "husky",
    "check:app-lint": "biome check --config-path=packages/core/app-biome.json packages/template/app/src",
    "check:template-snapshot": "node --experimental-strip-types apps/factory/scripts/bake-template-snapshot.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@sfab-lite/biome-config": "workspace:*",
    "@sfab-lite/tsconfig": "workspace:*",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "turbo": "^2.7.4",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.5.2",
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
