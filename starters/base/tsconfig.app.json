// Payload config — deliberately mirrors the factory check worker's
// compiler options (factory/check, ls-host `compilerOptions()`), so that
// `tsc` here sees what an app sees in the factory. Two rules:
//
//   1. No ambient types the factory does not have. That is why
//      `@cloudflare/workers-types` and `vite/client` are absent: the
//      factory resolves a small hand-written Cloudflare surface
//      (`@sfab-lite/core`'s `cloudflare-ambient.d.ts`, baked into the
//      types VFS) and nothing else. Typechecking against the full
//      workers types locally would green-light code the factory cannot
//      resolve.
//   2. Stricter here is fine; looser is not. `noUncheckedIndexedAccess`
//      (from base) is stricter than the factory — no false greens.
{
  "extends": "@sfab-lite/tsconfig/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": [],
    "allowImportingTsExtensions": true
  },
  "include": [
    "app/src",
    "../../framework/toolchain/src/cloudflare-ambient.d.ts"
  ]
}
