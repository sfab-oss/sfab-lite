{
  "name": "@sfab-lite/starter-base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./generated/seed.json"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,green \"pnpm dev:api\" \"pnpm dev:ui\"",
    "dev:api": "wrangler dev --port 8787",
    "dev:ui": "vite --port 5173",
    "build": "vite build",
    "preview": "pnpm build && wrangler dev --port 8787",
    "db:migrate": "wrangler d1 migrations apply sfab-lite-starter-base --local",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate",
    "pack": "node scripts/pack.mjs",
    "bake-seed": "node scripts/pack.mjs --out=generated/seed.json",
    "generate": "node --experimental-strip-types scripts/generate-format-files.mjs",
    "generate-routes": "tsr generate && node scripts/rewrite-route-tree-banner.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@radix-ui/react-icons": "1.3.2",
    "@tanstack/react-query": "5.83.0",
    "@tanstack/react-router": "1.129.0",
    "better-auth": "1.6.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.31",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.3.1",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@sfab-lite/tsconfig": "workspace:*",
    "@tailwindcss/vite": "4.1.11",
    "@tanstack/router-cli": "1.129.0",
    "@types/node": "^22.16.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.0",
    "tailwindcss": "4.1.11",
    "typescript": "6.0.3",
    "vite": "7.0.6",
    "wrangler": "4.113.0"
  }
}
